# ------------------------------------------------------- Accounts and backup --
# Without these the app runs entirely on the device: no accounts, no sync. With
# them, a wardrobe lives on your own machine and survives a lost phone.
#
# Nothing here goes to any third party, and there is nothing to pay for.

# Signs the session cookies. Any long random string; changing it signs everyone
# out. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
FITCHECK_SECRET=

# People who can sign in, as name:salt:hash entries separated by ';'.
# Passwords are never stored — run this once per person and paste the line:
#   npm run add-user -- lia
FITCHECK_USERS=

# Where wardrobes are written. One folder per person, plus their photos.
# Back this directory up and nothing else matters.
FITCHECK_DATA_DIR=./data

# ------------------------------------------------------- Daily reminders --
# One push notification a day, sent by this server. No third party, nothing to
# pay for. Generate a pair once:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Without them the app works exactly as before and the reminder setting says so.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Set to true only if you are serving over plain http on a LAN, which stops the
# session cookie being marked Secure. Behind nginx with TLS, leave it unset.
# FITCHECK_INSECURE=

# Where the optional garment-parsing model is fetched from. Unset, it comes from
# huggingface.co the first time and is cached forever after. Point it at a copy
# you host and this app talks to nothing but your own server.
# NEXT_PUBLIC_MODEL_HOST=https://models.example.com
