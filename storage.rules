rules_version = '2';

/*
 * Photographs of someone's clothes are as private as the wardrobe itself, so
 * the same rule applies: only the owner, and only under their own prefix.
 *
 * The size cap is a guard against a runaway upload, not a product limit — the
 * app downscales every photo to 1400px before it is stored, which lands well
 * under a megabyte.
 */
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /wardrobes/{userId}/photos/{photoId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
